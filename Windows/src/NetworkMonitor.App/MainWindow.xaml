<Window
    x:Class="NetworkMonitor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Network Monitor">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="28,22" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="Network Monitor" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="NetworkLabel" Text="Checking network connection…" Opacity="0.65" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#3BA776" />
                <TextBlock x:Name="StatusText" Text="Monitoring" VerticalAlignment="Center" />
                <Button Content="Hide to tray" Click="HideToTray_Click" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="28,4,28,28" Spacing="22">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="6"><TextBlock Text="DOWNLOAD" FontSize="11" CharacterSpacing="1.2" Opacity="0.6" /><TextBlock x:Name="DownloadSpeed" Text="—" FontSize="24" FontWeight="SemiBold" /><TextBlock x:Name="TodayDownload" Text="Today: —" Opacity="0.65" /></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="6"><TextBlock Text="UPLOAD" FontSize="11" CharacterSpacing="1.2" Opacity="0.6" /><TextBlock x:Name="UploadSpeed" Text="—" FontSize="24" FontWeight="SemiBold" /><TextBlock x:Name="TodayUpload" Text="Today: —" Opacity="0.65" /></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="6"><TextBlock Text="TOTAL TODAY" FontSize="11" CharacterSpacing="1.2" Opacity="0.6" /><TextBlock x:Name="TodayTotal" Text="—" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Interface counter deltas" Opacity="0.65" /></StackPanel>
                    </Border>
                </Grid>

                <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="14">
                        <Grid><TextBlock Text="This month · usage by day" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="MonthTotal" HorizontalAlignment="Right" Opacity="0.65" /></Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="MonthChart" Orientation="Horizontal" Height="150" VerticalAlignment="Bottom" Spacing="5" />
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="#3970DE" /><TextBlock Text="Download" FontSize="12" Opacity="0.7" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="#38A483" /><TextBlock Text="Upload" FontSize="12" Opacity="0.7" /></StackPanel>
                        </StackPanel>
                        <TextBlock Text="Bars show download and upload by local calendar day. Early history begins when monitoring starts." FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <Grid><TextBlock Text="Network interfaces" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="System interface counters" HorizontalAlignment="Right" Opacity="0.6" /></Grid>
                            <ListView x:Name="InterfaceList" IsItemClickEnabled="False" SelectionMode="None" MaxHeight="320">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,9" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /><ColumnDefinition Width="112" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Kind}" FontSize="12" Opacity="0.6" /></StackPanel>
                                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding DownloadText}" /><TextBlock Text="↓ download" FontSize="11" Opacity="0.6" /></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="{Binding UploadText}" /><TextBlock Text="↑ upload" FontSize="11" Opacity="0.6" /></StackPanel>
                                            <StackPanel Grid.Column="3"><TextBlock Text="{Binding LifetimeText}" /><TextBlock Text="recorded total" FontSize="11" Opacity="0.6" /></StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="ErrorText" Foreground="#D64C4C" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Measurement notes" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Rates come from changes in passive Windows interface byte counters." TextWrapping="Wrap" />
                            <TextBlock Text="Counters include broadcast and multicast. VPN or virtual adapters can overlap physical traffic." TextWrapping="Wrap" Opacity="0.7" />
                            <TextBlock Text="SSID comes from the current Windows connection profile. Per-network history and BSSID tracking are not enabled yet. No packet contents are inspected." TextWrapping="Wrap" Opacity="0.7" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
